{
  "name": "@vhbs/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell (Electron) for the Vietnam Historical Battles Simulator",
  "main": "src/main.cjs",
  "scripts": {
    "prestart": "npm run build -w @vhbs/game-ui",
    "start": "electron .",
    "package": "npm run build -w @vhbs/game-ui && electron-builder --dir",
    "dist": "npm run build -w @vhbs/game-ui && electron-builder",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "vn.vhbs.simulator",
    "productName": "Vietnam Historical Battles",
    "files": [
      "src/**/*",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../game-ui/dist",
        "to": "app"
      }
    ],
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.strategy-games"
    }
  }
}